# Copy to .env to override compose defaults. All optional — the stack runs as-is.
# MYSQL_ROOT_PASSWORD=rootpass
# MYSQL_DATABASE=neo_07
# DB_URL=jdbc:mysql://mysql:3306/neo_07
# DB_USERNAME=appuser
# DB_PASSWORD=apppass
# DB_PORT=3307
# BACKEND_PORT=8080
# FRONTEND_PORT=5173
# CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:*,http://127.0.0.1:*

# The sidecar (the mock orchestrator). Built from github.com/gjavolce/neobank-sidecar.
# SIDECAR_PORT=9000            clashes with neo-00's API_PORT — see below
# SIDECAR_REF=v1               git ref to build; `main` follows the latest instead of releases
# MODULE_URL=http://backend:8080          where the sidecar sends applications
#
# Running the neo-00 system stack at the same time? Both want host 9000. Move one:
#   SIDECAR_PORT=9100 docker compose up          (here)
#   API_PORT=9100 docker compose up              (in neo-00)

# Identity + behaviour (the system compose sets these per service)
# SERVICE_ID=neo07
# SERVICE_NAME=Card Account Setup
# SERVICE_DOMAIN=verification          BIAN domain you own; shown on /info
# ORCHESTRATOR_URL=http://sidecar:8080 the mock; http://orchestrator:8080 is the real one
# WORKER_POOL_SIZE=8                   threads available to run your rules

# The "what has been mocked" register, served live on /info — comma-separated external
# systems this module stands in for. Empty is a claim that nothing is mocked.
# MOCKED_DEPENDENCIES=id-verification-provider,sanctions-list

# There are no decision knobs. What this module answers comes from your rules in
# service/DecisionRules.java — not from weights, a seed or an env var.
